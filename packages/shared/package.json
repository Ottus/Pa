{
  "name": "@parcelo/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared code, theme, tokens, components, constants, and Firebase integration for Parcelo apps",
  "main": "src/index.js",
  "module": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./theme/*": "./src/theme/*",
    "./constants/*": "./src/constants/*",
    "./utils/*": "./src/utils/*",
    "./firebase/*": "./src/firebase/*",
    "./context/*": "./src/context/*",
    "./components/*": "./src/components/*"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^10.12.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.395.0",
    "tailwind-merge": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^18.3.0",
    "react-dom": "^18.2.0 || ^18.3.0"
  }
}
