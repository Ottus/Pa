rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // Default deny all storage objects
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Proof-of-delivery photos
    // In Phase 1: Uploaded only by Admin
    // Restricted to JPG and PNG, max size 2MB
    match /proofs/{shipmentId}/{fileName} {
      allow read: if signedIn(); // Or served via tokenized/signed URL
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }
  }
}

